server {
    listen 8080;
    server_name localhost;
    root /var/www/public;
    client_max_body_size 0;

    location / {
        # Try to serve the file directly, then fall back to index.php
        try_files $uri /index.php$is_args$args;
    }

    error_log /var/log/nginx/error.log ${LOG_LEVEL};

    location ~ ^/index\.php(/|$) {
        fastcgi_pass ${APP_HOST}:${APP_PORT};
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        internal;
    }

    # Return 404 for all other PHP files
    location ~ \.php$ {
        return 404;
    }

    # Ministry of Justice security.txt
    rewrite ^/.well_known/security.txt$ https://raw.githubusercontent.com/ministryofjustice/security-guidance/master/contact/vulnerability-disclosure-security.txt permanent;
}
